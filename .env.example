# ==============================================================================
# Environment Configuration - SMS Registry Module (PEN Global Assessment)
# ==============================================================================

# Neon Serverless PostgreSQL connection string (Pooled with PgBouncer, port 6543)
# Used for runtime queries in serverless functions
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.c-2.neon.tech/sms-registry-db?sslmode=require"

# Neon Direct PostgreSQL connection string (Unpooled direct connection, port 5432)
# Required by Prisma for DDL operations, migrations, and db push (bypassing PgBouncer)
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].c-2.neon.tech/sms-registry-db?sslmode=require"

# Next.js Application Port (Optional, default 3000)
PORT=3000
